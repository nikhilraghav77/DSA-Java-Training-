class Solution {
    public boolean canPartitionGrid(int[][] grid) {
        if( (grid[0][0] + grid[0][1]) == (grid[1][0] + grid[1][1])){
            return true;
        }
        else if((grid[0][0] + grid[1][0]) == (grid[0][1] + grid[1][1])){
             return true;

        }else{
            return false;
        }
        
    }
}

Above code is simple logic for 2x2 matrix but we to perform for mxn 


class Solution {
    public boolean canPartitionGrid(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;

        long total = 0;

        // total sum
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                total += grid[i][j];
            }
        }

        if (total % 2 != 0) return false;

        long curr = 0;

        // row partition
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                curr += grid[i][j];
            }
            if (curr == total - curr && i < m - 1) {
                return true;
            }
        }

        curr = 0;

        // column partition
        for (int j = 0; j < n; j++) {
            for (int i = 0; i < m; i++) {
                curr += grid[i][j];
            }
            if (curr == total - curr && j < n - 1) {
                return true;
            }
        }

        return false;
    }
}
