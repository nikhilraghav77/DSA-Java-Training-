class Solution {
    public boolean canPartitionGrid(int[][] grid) {
        if( (grid[0][0] + grid[0][1]) == (grid[1][0] + grid[1][1])){
            return true;
        }
        else if((grid[0][0] + grid[1][0]) == (grid[0][1] + grid[1][1])){
             return true;

        }else{
            return false;
        }
        
    }
}

