Q - Count Binary String without Consecutive One's (GFG)

public class Main
{
    public static int countString(int n) {
        // base ondition
        if(n == 0) return 1;
        if(n == 1) return 2;
        if(n == 2) return 3;
        //logic
        return countString(n-1) + countString(n-2);
    }
	public static void main(String[] args) {
	    int n = 3;
		System.out.println(countString(n));
	}
}


Dynamic Programming 

public static int countString(int n){
if(n==0) return 1;

int[] dp = new int[n+1];
dp[0] = 1;
dp[1] = 2;

for(int i =2; i<= n; i++){
dp[i] = dp[i-1] +dp[i-2];
}
return dp[n];
}
